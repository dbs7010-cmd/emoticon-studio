{
  "name": "emoticon-studio",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "expo": "~57.0.21",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "test:ux": "node scripts/ux-test.cjs && node scripts/gesture-test.cjs",
    "test:painter": "node scripts/painter-test.cjs",
    "export:native": "expo export --platform android --platform ios",
