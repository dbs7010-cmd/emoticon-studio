{
  "name": "emoticon-studio",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.6",
    "expo-iap": "^5.6.0",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:ux",
    "test:ux": "node scripts/ux-test.cjs && node scripts/storage-test.cjs && node scripts/gesture-test.cjs && node scripts/fill-test.cjs && node scripts/export-test.cjs && node scripts/spec-test.cjs && node scripts/recovery-test.cjs && node scripts/e2e-test.cjs && node scripts/pro-test.cjs && node scripts/server-test.cjs && node scripts/color-test.cjs && node scripts/motion-v1-test.cjs && node scripts/iap-test.cjs && node scripts/asset-check-test.cjs && node scripts/release-check-test.cjs && node scripts/product-ux-test.cjs && node scripts/viewport-matrix-test.cjs && node scripts/slot-repeat-test.cjs && node scripts/visual-system-test.cjs && node scripts/device-qa.cjs --dry",
    "device:pair": "node scripts/device-qa.cjs --pair",
    "device:connect": "node scripts/device-qa.cjs --connect",
    "device:qa": "node scripts/device-qa.cjs --run",
    "test:color-engine": "node scripts/color-engine-test.cjs",
    "assets:check": "node scripts/asset-check.cjs",
    "release:check": "node scripts/release-check.cjs",
    "release:apply-signing": "node scripts/apply-release-signing.cjs",
    "test:brush-engine": "node scripts/brush-engine-test.cjs",
    "test:painter": "node scripts/painter-test.cjs",
    "export:native": "expo export --platform android --platform ios",
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "test:flow": "node scripts/flow-test.cjs",
    "test:device-proxy": "node scripts/device-proxy-test.cjs",
    "test:motion": "node scripts/motion-test.cjs",
    "start:dev": "expo start --dev-client",
    "android:dev": "expo start --dev-client --android",
    "prebuild:android": "expo prebuild --platform android"
  },
  "private": true
}
