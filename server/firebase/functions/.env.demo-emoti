# 로컬 에뮬레이터 전용(프로젝트 demo-emoti) — 비밀 값이 아니다. 로그인은 test/mock-providers.cjs 의 가짜 서버(127.0.0.1:7777)를 본다.
# 운영 값은 functions/.env.<운영 프로젝트 ID>(공개 값만) + Secret Manager(Client Secret) — docs/closed-test/18_실제연결_설정안내.md
AUTH_BASE_URL=http://127.0.0.1:5000
KAKAO_REST_KEY=kakao-rest-key
NAVER_CLIENT_ID=naver-client-id
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
KAKAO_AUTH_BASE=http://127.0.0.1:7777
KAKAO_API_BASE=http://127.0.0.1:7777
NAVER_AUTH_BASE=http://127.0.0.1:7777
NAVER_API_BASE=http://127.0.0.1:7777
GOOGLE_AUTH_URL=http://127.0.0.1:7777/google/auth
GOOGLE_TOKEN_URL=http://127.0.0.1:7777/google/token
TRIAL_MAX_DAYS=30
STALE_UPLOAD_HOURS=24
BACKUP_QUOTA_BYTES=5000000
RETENTION_PRO_LAPSE_DAYS=90
RETENTION_CONTEST_NOT_SELECTED_DAYS=90
RETENTION_CONTEST_SELECTED_DAYS=365
RETENTION_AUTO_DELETE=false
# 구매 확인(2026-10-13): 가짜 Play Developer API · 테스트 구매 받음(비공개 테스트와 같은 설정)
PLAY_API_BASE=http://127.0.0.1:7777
PLAY_API_FAKE_TOKEN=fake-play-token
PURCHASE_ACCEPT_TEST=true
