{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      }
    },
    "screenshots": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "screenshots",
      "ios": {
        "simulator": true
      },
      "env": {
        "EMOTICON_INTERNAL_REVIEW": "1",
        "EMOTICON_SCREENSHOT_BUILD": "1"
      }
    }
  },
